{
  "name": "point-ledger-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Point Ledger Service for ae-framework evaluation",
  "engines": {
    "node": ">=20.11 <23"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:acceptance": "vitest run tests/acceptance",
    "test:acceptance:report": "scripts/acceptance/run-and-report.sh",
    "test:acceptance:summary": "node scripts/acceptance/generate-lgacc-summary.mjs",
    "test:e2e:postgres": "vitest run tests/e2e",
    "test:property": "vitest run tests/property",
    "test:mbt": "vitest run tests/mbt",
    "traceability:issue1": "node scripts/traceability/generate-issue1-traceability-matrix.mjs docs/specs/ISSUE1-TRACEABILITY-MATRIX.md",
    "verify:dev": "pnpm run typecheck && pnpm run test",
    "ae:phase2": "scripts/ae/phase2-run.sh"
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "pg": "^8.12.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "@types/pg": "^8.11.10",
    "fast-check": "^3.23.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  }
}
